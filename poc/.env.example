# Copia questo file in .env (che non va mai su Git) e compila i valori.
# Online, le stesse variabili si impostano nel pannello dell'hosting.

# Chiave API di Resend: https://resend.com/api-keys
RESEND_API_KEY=

# Mittente: deve appartenere a un dominio verificato su Resend.
# Finché il dominio non è verificato si può usare onboarding@resend.dev,
# che però consegna solo all'indirizzo con cui è registrato l'account Resend.
MAIL_FROM="Sito Sandra Di Scipio <onboarding@resend.dev>"

# Destinatario delle richieste (più indirizzi separati da virgola)
MAIL_TO=discipiosandra@gmail.com

# Usata da astro.config.mjs in build: SITE_URL=https://… npm run build
SITE_URL=https://www.sandradiscipio.it
