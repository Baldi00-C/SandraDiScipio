---
/**
 * Immagine ottimizzata (AVIF/WebP via astro:assets) con:
 *  - 03 · Photo curtain reveal: 7 strisce del colore della superficie (80 ms di stagger)
 *  - 04 · Parallax facoltativo, limitato al 7% o 14% dell'altezza della cornice
 *  - 05 · Zoom all'hover (dentro la cornice) se `zoom`
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  imgClass?: string;
  curtain?: boolean;
  parallax?: 0 | 0.07 | 0.14;
  zoom?: boolean;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  fit?: 'cover' | 'contain';
  position?: string;
}

const {
  src,
  alt,
  widths = [480, 800, 1200, 1600],
  sizes = '(max-width: 860px) 100vw, 50vw',
  class: className,
  imgClass,
  curtain = true,
  parallax = 0,
  zoom = false,
  loading = 'lazy',
  fetchpriority = 'auto',
  fit = 'cover',
  position = 'center',
} = Astro.props;

const usable = widths.filter((w) => w <= src.width);
const finalWidths = usable.length ? usable : [src.width];
---

<figure
  class:list={['curtain-frame relative m-0 overflow-hidden', zoom && 'media-zoom', className]}
  data-curtain={curtain ? '' : undefined}
>
  <div
    class="parallax-layer absolute inset-0"
    data-parallax={parallax ? String(parallax) : undefined}
    style={parallax ? `inset: -${parallax * 100}% 0;` : undefined}
  >
    <Picture
      src={src}
      alt={alt}
      widths={finalWidths}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      class:list={['block h-full w-full', imgClass]}
      style={`object-fit:${fit};object-position:${position};`}
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
  </div>
  {
    curtain && (
      <div class="curtain" aria-hidden="true">
        {Array.from({ length: 7 }, (_, i) => (
          <span style={`--i:${i}`} />
        ))}
      </div>
    )
  }
  <slot />
</figure>
