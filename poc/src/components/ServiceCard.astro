---
/**
 * Service card (Figma 3:299) — card quadrata text-only.
 * Con `image` attiva la variante "image card" (motion 06): su desktop con
 * puntatore l'immagine passa dal 60% al 34% di larghezza e al 55% di opacità,
 * il titolo sale di 62 px e la descrizione compare da +12 px. Su touch,
 * tablet e con reduced motion resta la card statica con tutto visibile.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  href?: string;
  linkLabel?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  class?: string;
}
const {
  eyebrow,
  title,
  description,
  href = '/servizi/',
  linkLabel = 'Scopri i servizi',
  image,
  imageAlt = '',
  class: className,
} = Astro.props;
---

<a
  href={href}
  class:list={['service-card group', image && 'has-image', className]}
>
  {
    image && (
      <div class="service-media" aria-hidden="true">
        <Picture
          src={image}
          alt={imageAlt}
          widths={[400, 700]}
          sizes="(max-width: 860px) 100vw, 400px"
          formats={['avif', 'webp']}
          class="h-full w-full object-cover"
          pictureAttributes={{ class: 'block h-full w-full' }}
        />
      </div>
    )
  }
  <div class="service-body">
    <p class="eyebrow text-label">{eyebrow}</p>
    <h3 class="service-title mt-3 text-h3">{title}</h3>
    <p class="service-desc mt-3 text-small">{description}</p>
    <p class="service-link mt-auto pt-5 text-link font-medium uppercase">
      {linkLabel} <span class="arrow" aria-hidden="true">→</span>
    </p>
  </div>
</a>

<style>
  .service-card {
    position: relative;
    display: flex;
    min-height: 210px;
    overflow: hidden;
    background: var(--sd-background-canvas);
    border: 1px solid var(--sd-border-default);
    color: var(--sd-text-primary);
    text-decoration: none;
    transition: border-color 400ms var(--ease-editorial);
  }
  .service-card:hover {
    border-color: var(--sd-action-hover);
  }
  .service-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding: 24px 28px;
    width: 100%;
  }
  .service-media {
    display: none;
  }

  /* Variante image card: solo desktop con hover e senza reduced motion */
  @media (min-width: 861px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .has-image .service-media {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 60%;
      opacity: 1;
      transition:
        width 600ms var(--ease-editorial),
        opacity 600ms var(--ease-editorial);
    }
    .has-image .service-body {
      width: 40%;
      transition: width 600ms var(--ease-editorial);
    }
    .has-image .service-title {
      transform: translateY(40px);
      transition: transform 600ms var(--ease-editorial);
    }
    .has-image .service-desc {
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity 500ms var(--ease-editorial),
        transform 500ms var(--ease-editorial);
    }
    .has-image:hover .service-media,
    .has-image:focus-visible .service-media {
      width: 34%;
      opacity: 0.55;
    }
    .has-image:hover .service-body,
    .has-image:focus-visible .service-body {
      width: 66%;
    }
    .has-image:hover .service-title,
    .has-image:focus-visible .service-title {
      transform: none;
    }
    .has-image:hover .service-desc,
    .has-image:focus-visible .service-desc {
      opacity: 1;
      transform: none;
      transition-delay: 100ms;
    }
  }

  @media (max-width: 480px) {
    .service-body {
      padding: 24px 22px;
    }
  }
</style>
