---
/**
 * Brand mark / Original — simbolo estratto dal logo originale di Sandra
 * (geometria inalterata, da Figma nodo 3:402).
 * tone="dark": inchiostro con ombra bianca · tone="light": bianco su fondi scuri
 */
interface Props {
  size?: number;
  tone?: 'dark' | 'light';
  class?: string;
  title?: string;
}
const { size = 96, tone = 'dark', class: className, title } = Astro.props;
const main = tone === 'dark' ? 'var(--color-ink)' : 'var(--color-white)';
const offset = tone === 'dark' ? 'var(--color-white)' : 'rgba(255,255,255,0.28)';
---

