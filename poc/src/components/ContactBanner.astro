---
/**
 * Contact invitation / banner (Figma 3:326) + marquee "Parliamone" (motion 10).
 */
import Button from './Button.astro';

interface Props {
  title?: string;
  text?: string;
  cta?: string;
  href?: string;
  marquee?: boolean;
}
const {
  title = 'Hai un progetto da realizzare?',
  text = 'Ogni grande progetto nasce da una prima idea e da una conversazione.',
  cta = 'Parliamone',
  href = '/contatti/',
  marquee = true,
} = Astro.props;
const words = Array.from({ length: 8 }, () => 'Parliamone');
---

<section class="py-14" style="--curtain-color: var(--sd-background-subtle)">
  {
    marquee && (
      <div class="marquee mb-8 overflow-hidden border-y border-default py-3" aria-hidden="true">
        <div class="marquee-track marquee-text flex w-max gap-10 whitespace-nowrap font-display italic text-rose">
          {[...words, ...words].map((w) => (
            <span class="flex items-center gap-10">
              {w}
              <span class="text-h3 not-italic text-ochre">✦</span>
            </span>
          ))}
        </div>
      </div>
    )
  }
  <div class="wrap-wide">
    <div
      class="flex flex-col items-start justify-between gap-8 bg-subtle px-8 py-[26px] md:flex-row md:items-center"
      data-reveal
    >
      <div>
        <h2 class="text-h2">{title}</h2>
        <p class="mt-2 text-small">{text}</p>
      </div>
      <Button href={href}>{cta}</Button>
    </div>
  </div>
</section>
