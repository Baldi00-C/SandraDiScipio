---
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CurtainImage from '@/components/CurtainImage.astro';
import EditorialLink from '@/components/EditorialLink.astro';
import ProjectSlider from '@/components/ProjectSlider.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ContactForm from '@/components/ContactForm.astro';
import BrandMark from '@/components/BrandMark.astro';
import { services } from '@/data/services';
import { site } from '@/data/site';

import heroImg from '@/assets/projects/villa-castana-pavia/villa-castana-pavia-render-soggiorno.jpg';
import introMain from '@/assets/projects/appartamento-milano/appartamento-milano-render-soggiorno.jpg';
import introDetail from '@/assets/projects/villa-castana-pavia/villa-castana-pavia-controsoffitto-luci.jpg';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
const heroLight = await getImage({ src: heroImg, width: 1600, format: 'webp' });
---

<BaseLayout title={site.name} overlayHeader>
  <!-- HERO ------------------------------------------------------------- -->
  <section
    class="hero relative isolate flex min-h-[max(100svh,560px)] items-end overflow-hidden bg-cocoa text-white"
    data-pointer-light
    aria-labelledby="hero-title"
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="hero-settle absolute inset-0">
        <Picture
          src={heroImg}
          alt=""
          widths={[800, 1200, 1600]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="hero-photo h-full w-full object-cover"
          pictureAttributes={{ class: 'block h-full w-full' }}
        />
        <img src={heroLight.src} alt="" class="light-photo h-full w-full object-cover" decoding="async" />
      </div>
      <!-- Viraggio rosa e autunnale: velo rosa in multiply + gradiente cacao/terracotta -->
      <div class="absolute inset-0 bg-rose opacity-60 mix-blend-multiply"></div>
      <div class="absolute inset-0 bg-rose opacity-20 mix-blend-soft-light"></div>
      <div class="hero-veil absolute inset-0"></div>
      <div class="light-glow"></div>
    </div>

    <div class="wrap pb-12 pt-[140px] md:pb-14">
      <p class="eyebrow hero-fade text-sand" style="--delay:150ms">Architettura · Interior Design · Ristrutturazioni</p>
      <h1 id="hero-title" class="mt-6 font-display text-hero font-bold uppercase">
        <span class="hero-line" style="--delay:300ms"><span style="--delay:300ms">Progettiamo spazi,</span></span>
        <span class="hero-line md:pl-[120px]"><span style="--delay:500ms">realizziamo</span></span>
        <span class="hero-line md:pl-[60px]"><span style="--delay:700ms">emozioni.</span></span>
      </h1>
      <div class="md:pl-[120px]">
        <p class="hero-fade mt-8 max-w-[460px] text-body-lg text-white/90" style="--delay:1100ms">
          Diamo forma alle idee, trasformandole in ambienti unici, funzionali e ricchi di personalità.
        </p>
        <div class="hero-fade mt-8" style="--delay:1300ms">
          <EditorialLink href="/preventivatore/" inverse>Richiedi un preventivo</EditorialLink>
        </div>
      </div>
      <p class="eyebrow mt-8 text-sand/80">Render di progetto · Villa privata a Castana</p>
    </div>
  </section>

  <!-- INTRODUZIONE -------------------------------------------------------- -->
  <section class="section-y" aria-labelledby="intro-title">
    <div class="wrap grid items-start gap-14 md:grid-cols-[minmax(0,440px)_1fr] md:gap-16">
      <div class="relative mx-auto w-full max-w-[440px] pb-12">
        <CurtainImage
          src={introMain}
          alt="Render di un soggiorno con parete in mattoni e vetrata a telaio nero, appartamento a Milano"
          class="aspect-[420/580] w-[76%] bg-blush"
          sizes="(max-width: 860px) 76vw, 340px"
          widths={[420, 640, 840]}
          parallax={0.07}
        />
        <CurtainImage
          src={introDetail}
          alt="Dettaglio di controsoffitto con faretti incassati sopra una parete in mattoni"
          class="absolute! bottom-0 right-0 aspect-[260/300] w-[47%] border-[10px] border-canvas bg-blush"
          sizes="(max-width: 860px) 47vw, 260px"
          widths={[260, 520]}
          parallax={0.14}
        />
      </div>

      <div data-reveal-group>
        <p class="eyebrow text-label" data-reveal>Servizio completo e personalizzato</p>
        <h2 id="intro-title" class="mt-5 max-w-[540px] text-h1" data-reveal>Ogni spazio ha una storia da raccontare</h2>
        <div class="mt-7 max-w-[520px] space-y-4 text-body" data-reveal>
          <p>
            Dalla prima consulenza al rilievo degli spazi, dalla progettazione architettonica e d’interni alla gestione
            del cantiere, fino alla selezione e alla fornitura di arredi, materiali e complementi.
          </p>
          <p>
            Offriamo un servizio completo e personalizzato, accompagnando ogni cliente in tutte le fasi del progetto,
            con un approccio che unisce estetica, funzionalità e innovazione.
          </p>
          <p>Il nostro obiettivo è progettarla insieme a te.</p>
        </div>
        <div class="mt-8" data-reveal>
          <EditorialLink href="/servizi/">Scopri i nostri servizi</EditorialLink>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGETTI ------------------------------------------------------------ -->
  <section class="pb-section pt-10" aria-labelledby="projects-title">
    <div class="wrap">
      <ProjectSlider projects={projects}>
        <div slot="heading" data-reveal-group>
          <p class="eyebrow text-label" data-reveal>Progetti</p>
          <h2 id="projects-title" class="mt-3 text-display" data-reveal>I nostri progetti, <br class="md:hidden" />le nostre storie</h2>
        </div>
      </ProjectSlider>
    </div>
  </section>

  <!-- SERVIZI ------------------------------------------------------------- -->
  <section class="bg-cocoa pb-16 pt-16 text-white" style="--curtain-color: var(--color-cocoa)" aria-labelledby="services-title">
    <div class="wrap grid gap-4 md:grid-cols-2 md:items-end md:gap-12" data-reveal-group>
      <div>
      <p class="eyebrow text-sand" data-reveal>I nostri servizi</p>
      <h2 id="services-title" class="mt-4 text-display" data-reveal>Diamo forma alle tue idee</h2>
      </div>
      <p class="max-w-[520px] text-body text-white/85" data-reveal>
        Ogni progetto è diverso e merita un approccio personalizzato: dalla singola consulenza alla gestione completa
        dell’intervento.
      </p>
    </div>
    <div class="wrap-wide mt-8">
      <ul class="grid gap-6 md:grid-cols-2" role="list" data-reveal-group>
        {
          services.map((s) => (
            <li data-reveal>
              <ServiceCard
                eyebrow={s.eyebrow}
                title={'shortTitle' in s ? s.shortTitle : s.title}
                description={s.short}
                href={`/servizi/#${s.id}`}
                image={s.image}
                imageAlt={s.imageAlt}
                class="h-full"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CONTATTI ------------------------------------------------------------ -->
  <section class="bg-subtle" style="--curtain-color: var(--sd-background-subtle)" aria-labelledby="contact-title">
    <div class="marquee overflow-hidden border-b border-default py-3" aria-hidden="true">
      <div class="marquee-track marquee-text flex w-max gap-10 whitespace-nowrap font-display italic text-rose">
        {
          Array.from({ length: 16 }, () => (
            <span class="flex items-center gap-10">
              Parliamone <span class="text-h3 not-italic text-ochre">✦</span>
            </span>
          ))
        }
      </div>
    </div>
    <div class="wrap grid gap-12 pb-20 pt-16 md:grid-cols-[1fr_minmax(0,426px)] md:gap-16">
      <div data-reveal-group>
        <p class="eyebrow text-label" data-reveal>Contatti</p>
        <h2 id="contact-title" class="mt-4 text-display" data-reveal>Hai un progetto<br />da realizzare?<br />Parliamone!</h2>
        <p class="mt-6 max-w-[530px] text-body" data-reveal>
          Ogni grande progetto nasce da una prima idea e da una conversazione.
        </p>
        <p class="mt-6 text-body text-secondary" data-reveal>
          <a class="hover:text-action-hover" href={`mailto:${site.email}`}>{site.email}</a><br />
          <a class="hover:text-action-hover" href={site.phoneHref}>{site.phone}</a>
        </p>
        <div class="mt-8" data-reveal>
          <BrandMark size={64} />
        </div>
      </div>
      <div class="md:max-w-[426px]" data-reveal>
        <ContactForm source="home" id="home-contact" />
      </div>
    </div>
  </section>
</BaseLayout>
