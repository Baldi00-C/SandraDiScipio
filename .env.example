# Facoltativo. Il metodo principale è private/config.php.
# Queste variabili, se impostate come variabili d'ambiente del server
# (pannello hosting / SetEnv in .htaccess fuori da Git), hanno la precedenza
# sui valori di private/config.php. Non committare mai un file .env reale.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=info@example.com
SMTP_PASSWORD=
MAIL_FROM=info@example.com
MAIL_TO=discipiosandra@gmail.com
APP_KEY=
# Usata da astro.config.mjs in build: SITE_URL=https://… npm run build
SITE_URL=https://www.sandradiscipio.it
