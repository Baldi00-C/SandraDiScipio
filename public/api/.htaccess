# Solo i due endpoint del modulo sono raggiungibili
Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "^(csrf-token|send-mail)\.php$">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "^(csrf-token|send-mail)\.php$">
        Allow from all
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Cache-Control "no-store"
</IfModule>
