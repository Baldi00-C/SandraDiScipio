---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sandra Di Scipio — Architetta e Interior Designer">
  <main class="mx-auto max-w-(--container-site) px-6 py-24">
    <p class="text-sm tracking-widest text-muted uppercase">Pagina di prova</p>
    <h1 class="mt-4 font-display text-5xl text-ink">Sandra Di Scipio</h1>
    <p class="mt-6 max-w-prose text-lg text-muted">
      Architetta e interior designer. Il sito è in costruzione.
    </p>
    <div class="mt-10 h-px w-24 bg-accent"></div>
  </main>
</BaseLayout>
