---
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CurtainImage from '@/components/CurtainImage.astro';
import EditorialLink from '@/components/EditorialLink.astro';
import ProjectSlider from '@/components/ProjectSlider.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ContactForm from '@/components/ContactForm.astro';
import BrandMark from '@/components/BrandMark.astro';
import { services } from '@/data/services';
import { site } from '@/data/site';

import heroImg from '@/assets/projects/villa-castana-pavia/villa-castana-pavia-render-soggiorno.jpg';
import introMain from '@/assets/projects/appartamento-milano/appartamento-milano-render-soggiorno.jpg';
import introDetail from '@/assets/projects/villa-castana-pavia/villa-castana-pavia-controsoffitto-luci.jpg';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
const heroLight = await getImage({ src: heroImg, width: 1600, format: 'webp' });
---

<BaseLayout title={site.name} overlayHeader>
  <!-- HERO ------------------------------------------------------------- -->
  <section
    class="hero relative isolate flex min-h-[max(100svh,640px)] items-end overflow-hidden bg-ink text-white md:min-h-[900px]"
    data-pointer-light
    aria-labelledby="hero-title"
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="hero-settle absolute inset-0">
        <Picture
          src={heroImg}
          alt=""
          widths={[800, 1200, 1600]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
          pictureAttributes={{ class: 'block h-full w-full' }}
        />
        <img src={heroLight.src} alt="" class="light-photo h-full w-full object-cover" decoding="async" />
      </div>
      <div class="absolute inset-0 bg-ink opacity-40"></div>
      <div class="light-glow"></div>
    </div>

    <div class="wrap pb-16 pt-[176px] md:pb-[48px]">
      <p class="eyebrow hero-fade" style="--delay:150ms">Architettura · Interior Design · Ristrutturazioni</p>
      <h1 id="hero-title" class="mt-12 font-display text-hero font-bold uppercase">
        <span class="hero-line" style="--delay:300ms"><span style="--delay:300ms">Progettiamo spazi,</span></span>
        <span class="hero-line md:pl-[190px]"><span style="--delay:500ms">realizziamo</span></span>
        <span class="hero-line md:pl-[100px]"><span style="--delay:700ms">emozioni.</span></span>
      </h1>
      <div class="md:pl-[190px]">
        <p class="hero-fade mt-14 max-w-[480px] text-body-lg" style="--delay:1100ms">
          Diamo forma alle idee, trasformandole in ambienti unici, funzionali e ricchi di personalità.
        </p>
        <div class="hero-fade mt-[60px]" style="--delay:1300ms">
          <EditorialLink href="/preventivatore/" inverse>Richiedi un preventivo</EditorialLink>
        </div>
      </div>
      <p class="eyebrow mt-10 text-white/80">Render di progetto · Villa privata a Castana</p>
    </div>
  </section>

  <!-- INTRODUZIONE -------------------------------------------------------- -->
  <section class="section-y" aria-labelledby="intro-title">
    <div class="wrap grid items-start gap-14 md:grid-cols-[554px_1fr] md:gap-[86px]">
      <div class="relative pb-[60px] md:pb-[62px]">
        <CurtainImage
          src={introMain}
          alt="Render di un soggiorno con parete in mattoni e vetrata a telaio nero, appartamento a Milano"
          class="aspect-[420/580] w-[76%] bg-blush"
          sizes="(max-width: 860px) 76vw, 420px"
          widths={[420, 640, 840]}
          parallax={0.07}
        />
        <CurtainImage
          src={introDetail}
          alt="Dettaglio di controsoffitto con faretti incassati sopra una parete in mattoni"
          class="absolute! bottom-0 right-0 aspect-[260/300] w-[47%] border-[10px] border-canvas bg-blush"
          sizes="(max-width: 860px) 47vw, 260px"
          widths={[260, 520]}
          parallax={0.14}
        />
      </div>

      <div data-reveal-group>
        <p class="eyebrow text-label" data-reveal>Servizio completo e personalizzato</p>
        <h2 id="intro-title" class="mt-8 max-w-[540px] text-h1" data-reveal>Ogni spazio ha una storia da raccontare</h2>
        <div class="mt-[50px] max-w-[520px] space-y-6 text-body" data-reveal>
          <p>
            Dalla prima consulenza al rilievo degli spazi, dalla progettazione architettonica e d’interni alla gestione
            del cantiere, fino alla selezione e alla fornitura di arredi, materiali e complementi.
          </p>
          <p>
            Offriamo un servizio completo e personalizzato, accompagnando ogni cliente in tutte le fasi del progetto,
            con un approccio che unisce estetica, funzionalità e innovazione.
          </p>
          <p>Il nostro obiettivo è progettarla insieme a te.</p>
        </div>
        <div class="mt-10" data-reveal>
          <EditorialLink href="/servizi/">Scopri i nostri servizi</EditorialLink>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGETTI ------------------------------------------------------------ -->
  <section class="pb-[120px] pt-[60px]" aria-labelledby="projects-title">
    <div class="wrap">
      <div data-reveal-group>
        <p class="eyebrow text-label" data-reveal>Progetti</p>
        <h2 id="projects-title" class="mt-7 text-display" data-reveal>I nostri progetti,<br />le nostre storie</h2>
      </div>
      <div class="mt-[50px]">
        <ProjectSlider projects={projects} />
      </div>
    </div>
  </section>

  <!-- SERVIZI ------------------------------------------------------------- -->
  <section class="bg-ink pb-16 pt-20 text-white" style="--curtain-color: var(--color-ink)" aria-labelledby="services-title">
    <div class="wrap" data-reveal-group>
      <p class="eyebrow" data-reveal>I nostri servizi</p>
      <h2 id="services-title" class="mt-6 text-display" data-reveal>Diamo forma alle tue idee</h2>
      <p class="mt-6 max-w-[1040px] text-body" data-reveal>
        Ogni progetto è diverso e merita un approccio personalizzato: dalla singola consulenza alla gestione completa
        dell’intervento.
      </p>
    </div>
    <div class="wrap-wide mt-[72px]">
      <ul class="grid gap-6 md:grid-cols-2" role="list" data-reveal-group>
        {
          services.map((s) => (
            <li data-reveal>
              <ServiceCard
                eyebrow={s.eyebrow}
                title={'shortTitle' in s ? s.shortTitle : s.title}
                description={s.short}
                href={`/servizi/#${s.id}`}
                image={s.image}
                imageAlt={s.imageAlt}
                class="h-full"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CONTATTI ------------------------------------------------------------ -->
  <section class="bg-subtle" style="--curtain-color: var(--sd-background-subtle)" aria-labelledby="contact-title">
    <div class="marquee overflow-hidden border-b border-default py-5" aria-hidden="true">
      <div class="marquee-track flex w-max gap-12 whitespace-nowrap font-display text-display italic text-rose">
        {
          Array.from({ length: 16 }, () => (
            <span class="flex items-center gap-12">
              Parliamone <span class="text-h2 not-italic text-line">✦</span>
            </span>
          ))
        }
      </div>
    </div>
    <div class="wrap grid gap-14 pb-[100px] pt-[90px] md:grid-cols-[640px_1fr] md:gap-[114px]">
      <div data-reveal-group>
        <p class="eyebrow text-label" data-reveal>Contatti</p>
        <h2 id="contact-title" class="mt-7 text-display" data-reveal>Hai un progetto<br />da realizzare?<br />Parliamone!</h2>
        <p class="mt-[70px] max-w-[530px] text-body" data-reveal>
          Ogni grande progetto nasce da una prima idea e da una conversazione.
        </p>
        <p class="mt-10 text-body text-secondary" data-reveal>
          <a class="hover:text-action-hover" href={`mailto:${site.email}`}>{site.email}</a><br />
          <a class="hover:text-action-hover" href={site.phoneHref}>{site.phone}</a>
        </p>
        <div class="mt-14" data-reveal>
          <BrandMark size={96} />
        </div>
      </div>
      <div class="md:max-w-[426px]" data-reveal>
        <ContactForm source="home" id="home-contact" />
      </div>
    </div>
  </section>
</BaseLayout>
