---
/*
 * Root `/`: temporary. T-03.3 replaces it with automatic locale selection
 * (remembered choice → browser language → English, D-046).
 */
import { defaultLocale, localeNames, locales, pathFor } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sandra Di Scipio" locale={defaultLocale}>
  <main class="mx-auto max-w-(--container-site) px-6 py-24">
    <h1 class="font-display text-5xl">Sandra Di Scipio</h1>
    <ul class="mt-8 flex gap-6">
      {locales.map((l) => (
        <li>
          <a href={pathFor('home', l)} hreflang={l} lang={l} class="underline underline-offset-4">
            {localeNames[l]}
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
