---
/**
 * Services page (T-07.2, Figma `03 · Servizi`, D-094): intro, the four
 * services with sample image, description, what is included and the link to
 * the right quote path (REQ-SERV-2), Sandra's closing line, contact invitation.
 * Texts from "SITO WEB.docx"; images are the mockup samples, marked as such.
 */
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";

import furnishingImage from "../../../assets/home/intro-bedroom-sample.jpg";
import interiorImage from "../../../assets/home/intro-niche-sample.jpg";
import architectureImage from "../../../assets/services/architecture-sample.jpg";
import renovationImage from "../../../assets/services/renovation-sample.jpg";
import ContactCta from "../../../components/ContactCta.astro";
import Curtain from "../../../components/Curtain.astro";
import EditorialLink from "../../../components/EditorialLink.astro";
import { quoteHref, services } from "../../../data/services";
import { locales, pathFor, routes, useTranslations, type Locale } from "../../../i18n";
import type { UiKey } from "../../../i18n/ui/it";
import PageLayout from "../../../layouts/PageLayout.astro";

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang, services: routes.services[lang] } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const images = {
  architecture: architectureImage,
  interior: interiorImage,
  renovation: renovationImage,
  furnishing: furnishingImage,
};
const key = (number: number, field: string) => `services.s${number}${field}` as UiKey;

const items = services.map((service) => ({
  ...service,
  image: images[service.id],
  label: `${t("services.number")} / ${String(service.number).padStart(2, "0")}`,
  title: t(key(service.number, "Title")),
  text: t(key(service.number, "Text")),
  includes: t(key(service.number, "Items")).split("\n"),
  alt: t(key(service.number, "Alt")),
  quoteLabel: t(service.quotePath === "turnkey" ? "services.quoteTurnkey" : "services.quoteDesign"),
  quoteHref: quoteHref(pathFor("quote", locale), service.quotePath),
}));
---

<PageLayout
  title={`${t("nav.services")} — ${t("site.name")}`}
  description={t("services.description")}
  locale={locale}
  route="services"
>
  <section class="container-site flex flex-col gap-6 pt-12 pb-10 tablet:pt-20 tablet:pb-12">
    <p class="type-eyebrow text-text-label uppercase" data-reveal>
      {t("services.eyebrow")}
    </p>
    <h1 class="type-display-large" data-reveal style="--reveal-delay: 100ms">
      {t("services.heading")
        .split("\n")
        .map((line) => (
          <span class="block">{line}</span>
        ))}
    </h1>
    <p class="type-body max-w-[65rem]" data-reveal style="--reveal-delay: 200ms">
      {t("services.lead")}
    </p>
  </section>

  <div class="container-site">
    {items.map((item) => (
      <section
        aria-labelledby={`service-${item.id}`}
        class="grid gap-8 border-t border-border-default py-8 tablet:grid-cols-12 tablet:gap-gutter"
      >
        <div class="flex flex-col gap-3 tablet:col-span-4">
          <div class="relative aspect-[360/410] overflow-hidden" data-curtain>
            <Image
              src={item.image}
              alt={item.alt}
              widths={[360, 540, 720]}
              sizes="(min-width: 53.75rem) 30vw, 100vw"
              class="size-full object-cover"
            />
            <Curtain />
          </div>
          <p class="type-eyebrow text-text-label uppercase">{t("services.sampleImage")}</p>
        </div>
        <div class="flex flex-col gap-6 tablet:col-span-7 tablet:col-start-6 tablet:pl-6">
          <p class="type-eyebrow text-text-label uppercase" data-reveal>
            {item.label}
          </p>
          <h2 id={`service-${item.id}`} class="type-h2" data-reveal>
            {item.title}
          </h2>
          <p class="type-body" data-reveal>
            {item.text}
          </p>
          <ul class="type-body-small flex list-disc flex-col gap-1 pl-5 marker:text-text-label" data-reveal>
            {item.includes.map((entry) => (
              <li>{entry}</li>
            ))}
          </ul>
          <div class="pt-2" data-reveal>
            <EditorialLink href={item.quoteHref}>{item.quoteLabel}</EditorialLink>
          </div>
        </div>
      </section>
    ))}
    <p class="type-h2 max-w-[47.5rem] border-t border-border-default pt-8 pb-section" data-reveal>
      {t("services.closing")}
    </p>
  </div>

  <ContactCta
    title={t("services.ctaTitle")}
    text={t("services.ctaText")}
    label={t("services.ctaButton")}
    href={pathFor("contact", locale)}
  />
</PageLayout>
