---
import type { GetStaticPaths } from "astro";

import { locales, useTranslations, type Locale } from "../../i18n";
import PageLayout from "../../layouts/PageLayout.astro";

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<PageLayout title={t("home.title")} description={t("home.description")} locale={locale} route="home">
  <section class="container-site py-section">
    <p class="type-eyebrow text-text-label uppercase">{t("home.eyebrow")}</p>
    <h1 class="type-display-large mt-4">{t("site.name")}</h1>
    <p class="type-body-large mt-6 max-w-prose text-text-secondary">
      {t("site.role")}. {t("home.lead")}
    </p>
    <div class="mt-10 h-px w-24 bg-rose-deep"></div>
  </section>
</PageLayout>
