---
import "../styles/global.css";

import Alternates from "../components/Alternates.astro";
import type { Locale, RouteKey } from "../i18n";

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  /** Page key in `src/i18n/routes.ts`: generates canonical and hreflang links. */
  route?: RouteKey;
  /** Page below the route, same slug in every locale (D-084). */
  subpath?: string;
}

const { title, description, locale, route, subpath } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {route && <Alternates route={route} subpath={subpath} locale={locale} />}
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
