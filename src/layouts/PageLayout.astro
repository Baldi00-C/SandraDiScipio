---
/**
 * Layout of every site page: header, main content, footer and the floating
 * WhatsApp button (REQ-GLOB-1 … 3).
 */
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { useTranslations, type Locale, type RouteKey } from "../i18n";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  route: RouteKey;
}

const { title, description, locale, route } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout title={title} description={description} locale={locale} route={route}>
  <a
    href="#main"
    class="type-control sr-only z-50 bg-surface-default px-4 py-3 focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
  >
    {t("nav.skip")}
  </a>
  <div class="flex min-h-screen flex-col">
    <SiteHeader locale={locale} route={route} />
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </div>
  <WhatsAppButton locale={locale} />
</BaseLayout>
