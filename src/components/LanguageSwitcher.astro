---
import { localeNames, locales, pathFor, useTranslations, type Locale, type RouteKey } from "../i18n";

interface Props {
  route: RouteKey;
  locale: Locale;
}

const { route, locale } = Astro.props;
const t = useTranslations(locale);
---

<nav aria-label={t("nav.language")}>
  <ul class="flex gap-4 text-sm">
    {locales.map((targetLocale) => (
      <li>
        <a
          href={pathFor(route, targetLocale)}
          hreflang={targetLocale}
          lang={targetLocale}
          data-locale-choice={targetLocale}
          aria-current={targetLocale === locale ? "page" : undefined}
          class:list={["underline-offset-4 hover:underline", targetLocale === locale && "font-semibold underline"]}
        >
          {localeNames[targetLocale]}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  import "../scripts/remember-locale";
</script>
