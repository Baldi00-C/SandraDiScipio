---
/**
 * Modulo di contatto — invio via Fetch API a /api/contatti (Resend) senza ricaricare.
 * Protezioni lato client (lato server sono ripetute e obbligatorie):
 * honeypot nascosto, tempo minimo di compilazione, validazione dei campi.
 */
import TextField from './TextField.astro';
import Checkbox from './Checkbox.astro';
import Button from './Button.astro';
import Notice from './Notice.astro';

interface Props {
  phone?: boolean;
  source?: 'contatti' | 'home' | 'preventivatore';
  submitLabel?: string;
  id?: string;
}
const { phone = false, source = 'contatti', submitLabel = 'Richiedi una consulenza', id = 'contact-form' } = Astro.props;
---

<div class="contact-form-wrap" data-contact-wrap>
  <form
    id={id}
    class="space-y-5"
    action="/api/contatti"
    method="post"
    novalidate
    data-contact-form
    data-source={source}
  >
    <Notice tone="error" title="Richiesta non inviata" hidden class="mb-2" id={`${id}-error`}>
      Controlla i campi evidenziati e riprova.
    </Notice>

    <TextField name="name" label="Nome" placeholder="Il tuo nome" help="Come possiamo chiamarti?" required autocomplete="name" maxlength={80} />
    <TextField
      name="email"
      type="email"
      label="Email"
      placeholder="nome@esempio.it"
      help="Ti risponderemo a questo indirizzo."
      required
      autocomplete="email"
      inputmode="email"
      maxlength={120}
    />
    {
      phone && (
        <TextField
          name="phone"
          type="tel"
          label="Telefono"
          placeholder="+39 …"
          help="Se preferisci essere richiamato."
          autocomplete="tel"
          inputmode="tel"
          maxlength={30}
        />
      )
    }
    <TextField
      name="message"
      label="Messaggio"
      placeholder="Raccontaci il tuo progetto"
      help="Descrivi i tuoi spazi e le tue esigenze. Massimo 2.000 caratteri."
      multiline
      required
      maxlength={2000}
      rows={5}
    />

    <Checkbox name="privacy" required>
      Ho letto l’<a href="/privacy-policy/">informativa privacy</a> e acconsento al trattamento dei dati.
    </Checkbox>

    <!-- Honeypot: invisibile alle persone, compilato dai bot -->
    <div class="hp" aria-hidden="true">
      <label>Lascia vuoto questo campo <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <input type="hidden" name="form_ts" value="" data-ts />
    <input type="hidden" name="source" value={source} />
    <input type="hidden" name="estimate" value="" data-estimate-payload />

    <div class="pt-3">
      <Button type="submit" data-submit>{submitLabel}</Button>
    </div>
    <p class="text-small text-secondary">
      I campi con * sono obbligatori. Usiamo i tuoi dati solo per rispondere alla richiesta.
    </p>
  </form>

  <div class="confirm" data-confirm hidden tabindex="-1">
    <div class="confirm-inner">
      <svg viewBox="0 0 56 56" width="56" height="56" aria-hidden="true">
        <circle class="confirm-circle" cx="28" cy="28" r="25" fill="none" stroke="var(--sd-feedback-success)" stroke-width="1.5"></circle>
        <path class="confirm-tick" d="M17 29 25 37 40 20" fill="none" stroke="var(--sd-feedback-success)" stroke-width="1.8"></path>
      </svg>
      <h3 class="mt-6 text-h2">Grazie, richiesta inviata</h3>
      <p class="mt-3 text-body" data-confirm-text>
        Abbiamo ricevuto il tuo messaggio. Ti risponderemo il prima possibile.
      </p>
    </div>
  </div>
</div>

<style>
  .hp {
    position: absolute !important;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .confirm {
    padding: 32px 0;
  }
</style>

<script>
  import { initContactForms } from '@/scripts/contact-form';
  document.addEventListener('astro:page-load', initContactForms);
</script>
