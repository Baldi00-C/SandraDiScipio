---
/**
 * Contatto WhatsApp flottante con alone (motion 10: 100% → 145%, 2,8 s).
 * È un accento: lo stesso contatto è sempre presente anche in footer e Contatti.
 */
import { site } from '@/data/site';
---

<a
  href={site.whatsappHref}
  target="_blank"
  rel="noopener"
  class="wa-float halo"
  aria-label="Scrivi a Sandra su WhatsApp (si apre in una nuova scheda)"
>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" fill="currentColor">
    <path d="M16.04 3C8.86 3 3.03 8.82 3.03 16c0 2.29.6 4.53 1.74 6.5L3 29l6.68-1.75A12.96 12.96 0 0 0 16.04 29C23.2 29 29 23.18 29 16S23.2 3 16.04 3Zm0 23.65c-1.95 0-3.86-.52-5.53-1.51l-.4-.23-3.96 1.04 1.06-3.86-.26-.4A10.6 10.6 0 0 1 5.4 16c0-5.86 4.77-10.63 10.64-10.63 5.86 0 10.62 4.77 10.62 10.63 0 5.87-4.76 10.65-10.62 10.65Zm5.83-7.96c-.32-.16-1.89-.93-2.18-1.04-.3-.1-.5-.16-.72.16-.21.32-.82 1.04-1.01 1.25-.18.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.21-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66 0 1.57 1.14 3.09 1.3 3.3.16.21 2.25 3.43 5.44 4.8.76.33 1.35.53 1.82.68.76.24 1.46.21 2 .13.61-.09 1.89-.77 2.15-1.52.27-.74.27-1.38.19-1.52-.08-.13-.29-.21-.61-.37Z" />
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: var(--sd-action-default);
    color: var(--color-white);
    isolation: isolate;
    box-shadow: 0 10px 30px -12px rgba(29, 29, 27, 0.45);
    transition: background-color 250ms var(--ease-editorial);
  }
  .wa-float:hover {
    background: var(--sd-action-hover);
  }
  @media (max-width: 480px) {
    .wa-float {
      right: 16px;
      bottom: 16px;
    }
  }
  @media print {
    .wa-float {
      display: none;
    }
  }
</style>
