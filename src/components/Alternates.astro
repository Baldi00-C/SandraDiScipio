---
import { alternatesFor, pathFor, type Locale, type RouteKey } from "../i18n";

interface Props {
  route: RouteKey;
  locale: Locale;
  /** Page below the route, same slug in every locale (D-084). */
  subpath?: string;
}

const { route, locale, subpath } = Astro.props;
const toAbsolute = (path: string) => new URL(path, Astro.site ?? Astro.url).href;
---

<link rel="canonical" href={toAbsolute(pathFor(route, locale, subpath))} />
{alternatesFor(route, subpath).map(({ hreflang, path }) => (
  <link rel="alternate" hreflang={hreflang} href={toAbsolute(path)} />
))}
