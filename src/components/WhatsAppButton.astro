---
/**
 * Floating WhatsApp button (D-064): ink circle, white icon, rose-deep hover,
 * bottom right on every page. 48 px at 16 px from the edges on mobile,
 * 56 px at 24 px from 860 px. The open mobile menu covers it.
 */
import { whatsappHref } from "../data/contact";
import { useTranslations, type Locale } from "../i18n";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<a
  href={whatsappHref(t("whatsapp.message"))}
  target="_blank"
  rel="noopener"
  aria-label={`${t("whatsapp.label")} (${t("contact.newTab")})`}
  class="fixed right-4 bottom-4 z-40 inline-flex size-12 items-center justify-center rounded-pill bg-action-default text-action-label shadow-floating transition-colors duration-(--duration-fast) ease-editorial hover:bg-action-hover tablet:right-6 tablet:bottom-6 tablet:size-14"
>
  <WhatsAppIcon class="size-6 tablet:size-7" />
</a>
