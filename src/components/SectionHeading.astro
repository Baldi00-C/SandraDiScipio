---
/**
 * Section heading of the content pages (Figma `Heading` frames): eyebrow,
 * H2 title and an optional line of description.
 */
import { sectionHeadingClasses as classes } from "./classes";

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  /** Id of the title, to label the section with `aria-labelledby`. */
  id?: string;
}

const { eyebrow, title, description, id } = Astro.props;
---

<div class={classes.root}>
  <p class={classes.eyebrow}>{eyebrow}</p>
  <h2 id={id} class={classes.title}>
    {title}
  </h2>
  {description && <p class={classes.description}>{description}</p>}
</div>
