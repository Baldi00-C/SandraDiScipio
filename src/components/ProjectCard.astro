---
/**
 * Project card (D-068, Figma `Project card`): 3:4 photo cropped to fill,
 * H3 title and one line of details. The whole card is one link.
 * Hover: the photo zooms 4 % and the title turns rose-deep, underlined.
 * Without an image it shows the blush placeholder of the Figma card.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import { projectCardClasses as classes } from "./classes";

interface Props {
  href?: string;
  title: string;
  details: string;
  image?: ImageMetadata;
  alt?: string;
}

const { href, title, details, image, alt = "" } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag href={href} class={classes.root}>
  <div class={classes.media}>
    {image && (
      <Image
        src={image}
        alt={alt}
        widths={[400, 600, 800]}
        sizes="(min-width: 53.75rem) 33vw, 100vw"
        class={classes.image}
      />
    )}
  </div>
  <div class={classes.text}>
    <h3 class={classes.title}>{title}</h3>
    <p class={classes.details}>{details}</p>
  </div>
</Tag>
